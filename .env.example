# Supabase (Project Settings > API)
# Clave publicable: puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública de la aplicación (usada en metadatos y enlaces absolutos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo servidor. Nunca debe llevar el prefijo NEXT_PUBLIC_.
# Se obtiene en Supabase: Project Settings > API Keys > Secret keys (sb_secret_...).
SUPABASE_SECRET_KEY=

# Protege el endpoint de vencimiento de reservas invocado por Vercel Cron.
# Genéralo tú (no viene de Supabase): 32 bytes aleatorios en hex.
CRON_SECRET=
